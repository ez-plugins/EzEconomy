# EzEconomy .gitignore
# --------------------
# Ignore build outputs
/**/target/
/.mvn/wrapper/maven-wrapper.jar
/.gradle/
/build/

# Maven/Gradle test and coverage
jacoco.exec
*.exec
**/surefire-reports/

# Local server, benchmark outputs and downloads (do not commit)
/server/
/downloads/
/benchmark-output/
bench-lane-output.txt

# Plugin runtime artifacts and worlds
server/plugins/
server/logs/
server/world/
server/world_nether/
server/world_the_end/

# Databases and runtime state
*.db
*.sqlite
*.sqlite3

# IDE files
/.idea/
.vscode/
*.iml
*.ipr
*.iws

# Eclipse
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Logs, swap, temp
*.log
*.log.gz
*.swp
*.swo

# Node
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Misc
*.class
