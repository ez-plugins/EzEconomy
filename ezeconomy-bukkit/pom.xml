<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.ez-plugins</groupId>
        <artifactId>ezeconomy-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ezeconomy-bukkit</artifactId>
    <packaging>jar</packaging>
    <name>EzEconomy Bukkit Plugin Module</name>

    <build>
        <sourceDirectory>../src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>../src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>../src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- MockBukkit-v1.21 is incompatible with Paper 26.x (Registry API changed).
                 Exclude tests that call MockBukkit.mock() until mockbukkit-v26 is published. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <excludes>
                        <exclude>**/feature/PayAllAliasTest.java</exclude>
                        <exclude>**/feature/PayCommandEdgeCasesTest.java</exclude>
                        <exclude>**/service/PaymentExecutorCurrencyPreferenceTest.java</exclude>
                        <exclude>**/service/PaymentExecutorDistributedLockInsufficientFundsTest.java</exclude>
                        <exclude>**/service/PaymentExecutorDistributedLockSuccessTest.java</exclude>
                        <exclude>**/service/PaymentExecutorDistributedLockTest.java</exclude>
                        <exclude>**/service/PaymentExecutorEventCancelTest.java</exclude>
                        <exclude>**/service/PaymentExecutorRecipientNotFoundTest.java</exclude>
                        <exclude>**/service/PaymentExecutorSelfPayTest.java</exclude>
                        <exclude>**/service/PaymentExecutorSimpleTransferFailureTest.java</exclude>
                        <exclude>**/service/PaymentExecutorSimpleTransferOtherCurrencyMessagesTest.java</exclude>
                        <exclude>**/service/PaymentExecutorTest.java</exclude>
                        <exclude>**/service/format/CurrencyFormatterFormatTest.java</exclude>
                        <exclude>**/storage/GetPlayerTest.java</exclude>
                        <exclude>**/util/CurrencyUtilRoundToCurrencyTest.java</exclude>
                        <exclude>**/util/PlayerLookupTest.java</exclude>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-integration-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/integration/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <!-- Failsafe runs after the `package` phase, so Maven puts the
                                 shade-plugin output on the classpath instead of target/classes.
                                 The shaded JAR relocates Jaloquent, so BalanceModel in the JAR
                                 extends shaded.Model — incompatible with ModelRepository.save(BaseModel)
                                 from the unshaded Jaloquent → VerifyError at class discovery.
                                 Force failsafe to use target/classes (same as surefire). -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <includes>
                                <include>**/*IT.java</include>
                                <include>**/*IntegrationTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
